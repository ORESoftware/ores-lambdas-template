{
  "contractVersion": "1.0.0",
  "environment": "development",
  "requiredCapabilities": [
    "request-context",
    "panic-recovery",
    "request-id",
    "trace-context",
    "structured-logging",
    "metrics-red",
    "deadline-timeout",
    "payload-limit",
    "rate-limit",
    "json",
    "headers",
    "compression",
    "tls-policy",
    "security-headers",
    "idempotency",
    "ip-policy",
    "cache-etag",
    "content-negotiation",
    "schema-capture"
  ],
  "settings": {
    "requestIdHeader": "x-request-id",
    "traceHeader": "traceparent",
    "timeoutMs": 5000,
    "maxBodyBytes": 262144,
    "contextRegistryMaxEntries": 10000,
    "contextRegistryTtlMs": 30000,
    "rateLimit": {
      "enabled": true,
      "capacity": 100,
      "refillPerSecond": 20,
      "keyBy": ["ip", "route"],
      "policyId": "lambda-default",
      "algorithm": "token-bucket",
      "layer": "application",
      "failureMode": "local-only",
      "windowMs": 60000,
      "localCacheMaxEntries": 10000,
      "localCacheTtlMs": 30000,
      "keyNamespace": "lambda",
      "keyVersion": "v1",
      "keyDerivation": "ephemeral-hmac-sha256"
    },
    "compression": {
      "enabled": true,
      "minimumBytes": 1024,
      "algorithms": ["gzip"]
    },
    "tls": {
      "mode": "disabled",
      "requireHttps": false,
      "strictForwardedHeaders": true,
      "trustedProxyCidrs": []
    },
    "securityHeaders": {
      "enabled": true,
      "hstsMaxAgeSeconds": 0,
      "contentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'",
      "frameOptions": "DENY"
    },
    "idempotency": {
      "enabled": true,
      "headerName": "idempotency-key",
      "ttlSeconds": 86400,
      "requiredMethods": ["POST", "PUT", "PATCH"]
    },
    "faultInjection": {
      "enabled": false,
      "latencyMs": 0,
      "errorRate": 0,
      "dropRate": 0
    },
    "testAuthBypass": {
      "enabled": false,
      "headerName": "x-test-auth-bypass",
      "allowedCidrs": []
    },
    "contentRepresentations": ["application/json", "application/problem+json"]
  },
  "integrations": {
    "sharedAuth": {
      "mode": "disabled",
      "failOpen": false
    },
    "optoSync": {
      "mode": "disabled",
      "failOpen": false
    },
    "oresOtel": {
      "enabled": false,
      "serviceName": "__PREFIX__-lambdas",
      "propagators": ["tracecontext", "baggage"]
    }
  }
}
